generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String   @id @default(uuid())
  firstName      String
  lastName       String?
  email          String   @unique
  passwordHash   String
  telegramChatId String?
  country        String   @default("IN")
  currency       String   @default("INR")
  avatarUrl      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  assets          Asset[]
  transactions    Transaction[]
  categoryLimits  CategoryLimit[]
  userCategories  UserCategory[]
  userAssetTypes  UserAssetType[]
  plannedExpenses PlannedExpense[]
  goals           Goal[]
  debts           Debt[]
  incomeSources   IncomeSource[]
}

// ─── Normalized Lookup Tables ────────────────────────────────────────────────

model UserCategory {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  transactions    Transaction[]
  plannedExpenses PlannedExpense[]
  categoryLimits  CategoryLimit[]

  @@unique([userId, name])
}

model UserAssetType {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  assets Asset[]

  @@unique([userId, name])
}

// ─── Core Financial Tables ───────────────────────────────────────────────────

model Asset {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  typeId    String
  assetType UserAssetType @relation(fields: [typeId], references: [id])
  value     Float
  quantity  Float?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  transactions          Transaction[]
  transactionsTarget    Transaction[]    @relation("TransactionTargetAsset")
  plannedExpensesSource PlannedExpense[] @relation("SourceAsset")
  plannedExpensesTarget PlannedExpense[] @relation("TargetAsset")
  debts                 Debt[]
  goalsSource           Goal[]           @relation("GoalSourceAsset")
  goalsTarget           Goal[]           @relation("GoalTargetAsset")
  incomeSourcesDefault  IncomeSource[]   @relation("IncomeSourceDefaultAsset")
}

enum IncomeCategoryType {
  ACTIVE
  PASSIVE
}

model IncomeSource {
  id             String             @id @default(uuid())
  userId         String
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  type           IncomeCategoryType @default(ACTIVE)
  isFixed        Boolean            @default(true)
  expectedAmount Float?
  frequency      Frequency?
  defaultAssetId String?
  defaultAsset   Asset?             @relation("IncomeSourceDefaultAsset", fields: [defaultAssetId], references: [id], onDelete: SetNull)
  description    String?
  iconUrl        String?
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  transactions   Transaction[]

  @@unique([userId, name])
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

model Transaction {
  id               String          @id @default(uuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetId          String
  asset            Asset           @relation(fields: [assetId], references: [id], onDelete: Cascade)
  toAssetId        String?
  toAsset          Asset?          @relation(fields: [toAssetId], references: [id], onDelete: Cascade, name: "TransactionTargetAsset")
  type             TransactionType
  amount           Float
  categoryId       String
  category         UserCategory    @relation(fields: [categoryId], references: [id])
  incomeSourceId   String?
  incomeSource     IncomeSource?   @relation(fields: [incomeSourceId], references: [id], onDelete: SetNull)
  description      String
  date             DateTime
  receiptImageUrl  String?
  linkedDebtId     String?
  linkedDebtAction String?
  createdAt        DateTime        @default(now())
}

model CategoryLimit {
  id           String       @id @default(uuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId   String
  category     UserCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  monthlyLimit Float?
  yearlyLimit  Float?
  createdAt    DateTime     @default(now())

  @@unique([userId, categoryId])
}

// ─── Planning & Goals ────────────────────────────────────────────────────────

enum PlannedExpenseType {
  MANUAL
  RECURRING
}

enum Frequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

model PlannedExpense {
  id            String             @id @default(uuid())
  userId        String
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetId       String
  asset         Asset              @relation(name: "SourceAsset", fields: [assetId], references: [id], onDelete: Cascade)
  targetAssetId String?
  targetAsset   Asset?             @relation(name: "TargetAsset", fields: [targetAssetId], references: [id], onDelete: SetNull)
  name          String
  categoryId    String
  category      UserCategory       @relation(fields: [categoryId], references: [id])
  amount        Float
  type          PlannedExpenseType
  txType        TransactionType    @default(EXPENSE)
  frequency     Frequency?
  nextDueDate   DateTime?
  lastFundedAt  DateTime?
  createdAt     DateTime           @default(now())
}

model Goal {
  id                 String     @id @default(uuid())
  userId             String
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  targetAmount       Float
  currentAmount      Float      @default(0)
  expectedDate       DateTime
  isPinned           Boolean    @default(false)
  recurringAmount    Float?
  recurringFrequency Frequency?
  sourceAssetId      String?
  sourceAsset        Asset?     @relation(name: "GoalSourceAsset", fields: [sourceAssetId], references: [id])
  targetAssetId      String?
  targetAsset        Asset?     @relation(name: "GoalTargetAsset", fields: [targetAssetId], references: [id], onDelete: SetNull)
  lastFundedAt       DateTime?
  createdAt          DateTime   @default(now())

  images GoalImage[]
}

model GoalImage {
  id        String   @id @default(uuid())
  goalId    String
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  url       String
  createdAt DateTime @default(now())
}

// ─── Debts ───────────────────────────────────────────────────────────────────

enum DebtType {
  LENT
  BORROWED
}

enum DebtStatus {
  ACTIVE
  SETTLED
  EXPIRED
}

model Debt {
  id            String     @id @default(uuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetId       String
  asset         Asset      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  type          DebtType
  personName    String
  amount        Float
  settledAmount Float      @default(0)
  dueDate       DateTime?
  status        DebtStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())
}
