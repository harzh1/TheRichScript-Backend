generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── User ────────────────────────────────────────────────────────────────────

model User {
  id              String    @id @default(uuid())
  firstName       String
  lastName        String?
  email           String    @unique
  passwordHash    String
  telegramChatId  String?
  country         String    @default("IN")
  currency        String    @default("INR")
  avatarUrl       String?
  isActive        Boolean   @default(true)
  lastLoginAt     DateTime?
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  assets          Asset[]
  transactions    Transaction[]
  userCategories  UserCategory[]
  userAssetTypes  UserAssetType[]
  plannedExpenses PlannedExpense[]
  goals           Goal[]
  debts           Debt[]
  incomeSources   IncomeSource[]
  refreshTokens   RefreshToken[]
  contacts        Contact[]
  notifications   Notification[]
  auditLogs       AuditLog[]
}

// ─── Normalized Lookup Tables ────────────────────────────────────────────────

model UserCategory {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  monthlyLimit Decimal? @db.Decimal(19, 4)
  yearlyLimit  Decimal? @db.Decimal(19, 4)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  transactions    Transaction[]
  plannedExpenses PlannedExpense[]

  @@unique([userId, name])
  @@index([userId])
}

model UserAssetType {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  assets Asset[]

  @@unique([userId, name])
  @@index([userId])
}

// ─── Core Financial Tables ───────────────────────────────────────────────────

model Asset {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  typeId    String
  assetType UserAssetType @relation(fields: [typeId], references: [id])
  value     Decimal   @db.Decimal(19, 4)
  quantity  Decimal?  @db.Decimal(19, 4)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  transactions          Transaction[]
  transactionsTarget    Transaction[]    @relation("TransactionTargetAsset")
  plannedExpensesSource PlannedExpense[] @relation("SourceAsset")
  plannedExpensesTarget PlannedExpense[] @relation("TargetAsset")
  debts                 Debt[]
  goalsSource           Goal[]           @relation("GoalSourceAsset")
  goalsTarget           Goal[]           @relation("GoalTargetAsset")
  incomeSourcesDefault  IncomeSource[]   @relation("IncomeSourceDefaultAsset")

  @@index([userId])
  @@index([typeId])
}

enum IncomeCategoryType {
  ACTIVE
  PASSIVE
}

model IncomeSource {
  id             String             @id @default(uuid())
  userId         String
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  type           IncomeCategoryType @default(ACTIVE)
  isFixed        Boolean            @default(true)
  expectedAmount Decimal?           @db.Decimal(19, 4)
  frequency      Frequency?
  defaultAssetId String?
  defaultAsset   Asset?             @relation("IncomeSourceDefaultAsset", fields: [defaultAssetId], references: [id], onDelete: SetNull)
  description    String?
  iconUrl        String?
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  transactions Transaction[]

  @@unique([userId, name])
  @@index([userId])
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum DebtAction {
  CREATE
  SETTLE
  PARTIAL_PAYMENT
}

model Transaction {
  id               String          @id @default(uuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetId          String
  asset            Asset           @relation(fields: [assetId], references: [id], onDelete: Cascade)
  toAssetId        String?
  toAsset          Asset?          @relation(fields: [toAssetId], references: [id], onDelete: Cascade, name: "TransactionTargetAsset")
  type             TransactionType
  amount           Decimal         @db.Decimal(19, 4)
  categoryId       String?
  category         UserCategory?   @relation(fields: [categoryId], references: [id])
  incomeSourceId   String?
  incomeSource     IncomeSource?   @relation(fields: [incomeSourceId], references: [id], onDelete: SetNull)
  description      String?
  date             DateTime
  receiptImageUrl  String?
  linkedDebtId     String?
  linkedDebt       Debt?           @relation(fields: [linkedDebtId], references: [id], onDelete: SetNull)
  linkedDebtAction DebtAction?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  deletedAt        DateTime?

  @@index([userId])
  @@index([assetId])
  @@index([categoryId])
  @@index([userId, date])
  @@index([date])
}

// ─── Planning & Goals ────────────────────────────────────────────────────────

enum PlannedExpenseType {
  MANUAL
  RECURRING
}

enum Frequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

model PlannedExpense {
  id            String             @id @default(uuid())
  userId        String
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetId       String
  asset         Asset              @relation(name: "SourceAsset", fields: [assetId], references: [id], onDelete: Cascade)
  targetAssetId String?
  targetAsset   Asset?             @relation(name: "TargetAsset", fields: [targetAssetId], references: [id], onDelete: SetNull)
  name          String
  categoryId    String
  category      UserCategory       @relation(fields: [categoryId], references: [id])
  amount        Decimal            @db.Decimal(19, 4)
  type          PlannedExpenseType
  txType        TransactionType    @default(EXPENSE)
  frequency     Frequency?
  nextDueDate   DateTime?
  lastFundedAt  DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([userId])
  @@index([userId, nextDueDate])
}

model Goal {
  id                 String     @id @default(uuid())
  userId             String
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  targetAmount       Decimal    @db.Decimal(19, 4)
  currentAmount      Decimal    @default(0) @db.Decimal(19, 4)
  expectedDate       DateTime
  isPinned           Boolean    @default(false)
  recurringAmount    Decimal?   @db.Decimal(19, 4)
  recurringFrequency Frequency?
  sourceAssetId      String?
  sourceAsset        Asset?     @relation(name: "GoalSourceAsset", fields: [sourceAssetId], references: [id])
  targetAssetId      String?
  targetAsset        Asset?     @relation(name: "GoalTargetAsset", fields: [targetAssetId], references: [id], onDelete: SetNull)
  imageUrls          String[]
  lastFundedAt       DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([userId])
  @@index([userId, isPinned])
}

// ─── Debts ───────────────────────────────────────────────────────────────────

enum DebtType {
  LENT
  BORROWED
}

enum DebtStatus {
  ACTIVE
  SETTLED
  EXPIRED
}

model Debt {
  id            String     @id @default(uuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetId       String
  asset         Asset      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  type          DebtType
  personName    String
  contactId     String?
  contact       Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  amount        Decimal    @db.Decimal(19, 4)
  settledAmount Decimal    @default(0) @db.Decimal(19, 4)
  dueDate       DateTime?
  notes         String?
  status        DebtStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deletedAt     DateTime?

  transactions Transaction[]

  @@index([userId])
  @@index([userId, status])
}

// ─── Contacts ────────────────────────────────────────────────────────────────

model Contact {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  phone     String?
  email     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  debts Debt[]

  @@unique([userId, name])
  @@index([userId])
}

// ─── Notifications ───────────────────────────────────────────────────────────

enum NotificationType {
  DEBT_DUE
  GOAL_MILESTONE
  BUDGET_EXCEEDED
  PLANNED_EXPENSE_DUE
  SYSTEM
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

// ─── Audit Log ───────────────────────────────────────────────────────────────

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  PASSWORD_CHANGE
  SETTLE_DEBT
  FUND_GOAL
}

model AuditLog {
  id         String      @id @default(uuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  action     AuditAction
  entityType String
  entityId   String?
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now())

  @@index([userId, createdAt])
  @@index([entityType, entityId])
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([token])
}
